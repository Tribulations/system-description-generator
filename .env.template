# Claude API Configuration with default values
CLAUDE_API_KEY=your_claude_api_key
CLAUDE_API_URL=https://api.anthropic.com/v1/messages
CLAUDE_API_VERSION=2023-06-01
CLAUDE_MODEL=claude-3-5-sonnet-20241022
#CLAUDE_MODEL=claude-sonnet-4-5-20250929 # Higher quality but more expensive

# Gemini API Configuration with default values
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/
GEMINI_MODEL=gemini-2.0-flash
#GEMINI_MODEL=gemini-2.5-pro # Higher quality but more expensive
GEMINI_ENDPOINT=generateContent

# Neo4j default configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=devpassword

### Notes:
# If both a Gemini and Claude API key are set, *Gemini* will be used as default.
# The older models frequently fail to generate some diagrams.
# Commented-out models provide better quality but are slower, more costly,
# and frequently fail due to rate limits (tokens per minute).
# To handle this, a 62-second delay is applied when using these models.
# The delay can be modified in method MainController::generateAndDisplayDiagrams.
